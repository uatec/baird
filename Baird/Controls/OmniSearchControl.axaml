<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Baird.ViewModels"
             xmlns:controls="using:Baird.Controls"
             xmlns:conv="using:Baird.Converters"
             xmlns:services="using:Baird.Services"
             xmlns:asyncImage="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Baird.Controls.OmniSearchControl"
             x:CompileBindings="True"
             x:DataType="vm:OmniSearchViewModel">
             
    <UserControl.Resources>
        <conv:StringVisibilityConverter x:Key="StringVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="TextBox#SearchBox">
            <Setter Property="Background" Value="#1A1F2C"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>
        <Style Selector="TextBox#SearchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1A1F2C"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <Style Selector="ItemsControl#SuggestionsList Button">
            <Setter Property="Background" Value="#1E2330"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ItemsControl#SuggestionsList Button:focus">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>

        <Style Selector="Button.SeerrchTileButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SeerrchTileButton:focus">
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1E2330"/>
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
            <Setter Property="ZIndex" Value="10"/>
        </Style>
    </UserControl.Styles>

    <Grid Name="OmniSearchGrid" RowDefinitions="Auto,*,Auto" Background="Transparent"
          XYFocus.NavigationModes="Enabled"
          XYFocus.DownNavigationStrategy="Projection"
          XYFocus.UpNavigationStrategy="Projection"
          XYFocus.LeftNavigationStrategy="Projection"
          XYFocus.RightNavigationStrategy="Projection">
        
        <!-- Row 0: SearchBox -->
        <Border Grid.Row="0" Padding="20">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <Grid Grid.Column="0">
                        <TextBox Name="SearchBox" 
                                 Text="{Binding SearchText}" 
                                 FontSize="24" 
                                 Watermark="Search...">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Up" Command="{Binding $parent[controls:OmniSearchControl].MoveFocusUpCommand}" />
                                <KeyBinding Gesture="Down" Command="{Binding $parent[controls:OmniSearchControl].MoveFocusDownCommand}" />
                                <KeyBinding Gesture="Enter" Command="{Binding $parent[controls:OmniSearchControl].MoveFocusDownCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        
                        <!-- Progress bar along bottom border -->
                        <ProgressBar Height="4" 
                                     VerticalAlignment="Bottom" 
                                     HorizontalAlignment="Stretch"
                                     IsVisible="{Binding IsAutoActivationPending}"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding AutoActivationProgress}"
                                     Margin="0,0,0,-4"
                                     Foreground="#4CAF50"
                                     Background="Transparent" />
                    </Grid>

                    <!-- Provider Status Pips -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding ProviderStatuses}" Margin="15,0,0,0" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="15"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Request Status Banner -->
                <Border IsVisible="{Binding ShowRequestStatus}"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,10"
                        Margin="0,0,0,4">
                    <TextBlock Text="{Binding RequestStatusMessage}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#38BDF8"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Suggested Terms Pills -->
                <ItemsControl Name="SuggestionsList" 
                              ItemsSource="{Binding SuggestedTerms}"
                              XYFocus.Down="{Binding #ResultsList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" 
                                    Command="{Binding $parent[UserControl].DataContext.SearchTermCommand}"
                                    CommandParameter="{Binding}"
                                    CornerRadius="16"
                                    BorderThickness="1"
                                    BorderBrush="#555555"
                                    Background="#222222"
                                    Foreground="White"
                                    Padding="15,5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Row 1: Search Results -->
        <ScrollViewer Grid.Row="1"
                      Focusable="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      KeyboardNavigation.TabNavigation="Contained">
            <StackPanel Spacing="24" Margin="20,0,20,20">
                <!-- Section 1: In Library & Live TV -->
                <StackPanel Spacing="10" IsVisible="{Binding SearchResults.Count}">
                    <TextBlock Text="In Library &amp; Live TV"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#94A3B8"
                               Margin="4,0,0,0"/>
                    <ItemsControl Name="ResultsList"
                                  ItemsSource="{Binding SearchResults}"
                                  Background="Transparent"
                                  XYFocus.NavigationModes="Enabled">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MediaItemViewModel">
                                <controls:MediaTileControl
                                    Command="{Binding $parent[UserControl].DataContext.PlayCommand}"
                                    CommandParameter="{Binding}"
                                    LongPressCommand="{Binding $parent[UserControl].DataContext.AddToWatchlistCommand}"
                                    LongPressCommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Load More Button -->
                    <Button Content="Load More Results"
                            Command="{Binding LoadMoreCommand}"
                            IsVisible="{Binding HasMoreResults}"
                            HorizontalAlignment="Center"
                            Margin="16"
                            Padding="28,12"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Background="#1E2330"
                            Foreground="#94A3B8"
                            CornerRadius="20"/>
                </StackPanel>

                <!-- Section 2: Discover & Request (Jellyseerr) -->
                <StackPanel Spacing="10" IsVisible="{Binding DiscoverResults.Count}">
                    <TextBlock Text="Discover &amp; Request"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               Margin="4,0,0,0"/>
                    <ItemsControl Name="DiscoverResultsList"
                                  ItemsSource="{Binding DiscoverResults}"
                                  Background="Transparent"
                                  XYFocus.NavigationModes="Enabled">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SeerrchResultViewModel">
                                <Button Classes="SeerrchTileButton"
                                        Command="{Binding $parent[controls:OmniSearchControl].DataContext.RequestItemCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid RowDefinitions="*, Auto, Auto">
                                        <Border CornerRadius="8" ClipToBounds="True" Height="169" Background="#333333">
                                            <Image asyncImage:ImageLoader.Source="{Binding FullPosterUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Title}"
                                                   Foreground="#F8FAFC" FontWeight="SemiBold"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Left"
                                                   Margin="0,6,0,0"/>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                                            <Border Background="#1E293B" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BadgeText}" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowStatusBadge}">
                                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding ShowSpinner}">
            <TextBlock Text="Searching..." FontSize="20" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True" Width="200" Margin="0,10,0,0" Height="4"/>
        </StackPanel>
        <!-- Row 2: Virtual Keyboard -->
        <controls:VirtualKeyboardControl Grid.Row="2"
                                         Name="VirtualKeyboard"
                                         MaxWidth="760"
                                         HorizontalAlignment="Center"
                                         Margin="0,10,0,10"
                                         IsVisible="{Binding !HasAnyResults}"/>
    </Grid>
</UserControl>
