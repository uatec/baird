<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Baird.ViewModels"
             xmlns:controls="using:Baird.Controls"
             xmlns:conv="using:Baird.Converters"
             xmlns:services="using:Baird.Services"
             xmlns:asyncImage="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Baird.Controls.OmniSearchControl"
             x:CompileBindings="True"
             x:DataType="vm:OmniSearchViewModel">
             
    <UserControl.Resources>
        <conv:StringVisibilityConverter x:Key="StringVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="ItemsControl#SuggestionsList Button">
            <Setter Property="Background" Value="#1E2330"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ItemsControl#SuggestionsList Button:focus">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>
    </UserControl.Styles>

    <Grid Name="OmniSearchGrid" RowDefinitions="Auto,*" Background="Transparent"
          XYFocus.NavigationModes="Enabled"
          XYFocus.DownNavigationStrategy="Projection"
          XYFocus.UpNavigationStrategy="Projection"
          XYFocus.LeftNavigationStrategy="Projection"
          XYFocus.RightNavigationStrategy="Projection">

        <!-- Row 0: the query as typed on the keyboard, provider status and suggestions -->
        <Border Grid.Row="0" Padding="20,20,20,10">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <Border Grid.Column="0"
                            Background="#1A1F2C"
                            BorderBrush="#334155"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="16,10">
                        <Grid>
                            <TextBlock Name="SearchText"
                                       Text="{Binding SearchText}"
                                       FontSize="24"
                                       Foreground="#F8FAFC"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Search..."
                                       FontSize="24"
                                       Foreground="#64748B"
                                       IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                        </Grid>
                    </Border>

                    <!-- Progress bar along bottom border -->
                    <ProgressBar Grid.Column="0"
                                 Height="4"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Stretch"
                                 IsVisible="{Binding IsAutoActivationPending}"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding AutoActivationProgress}"
                                 Margin="0,0,0,-4"
                                 Foreground="#4CAF50"
                                 Background="Transparent" />

                    <!-- Provider Status Pips -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding ProviderStatuses}" Margin="15,0,0,0" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="15"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Suggested Terms Pills -->
                <ItemsControl Name="SuggestionsList"
                              ItemsSource="{Binding SuggestedTerms}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Command="{Binding $parent[UserControl].DataContext.SearchTermCommand}"
                                    CommandParameter="{Binding}"
                                    CornerRadius="16"
                                    BorderThickness="1"
                                    BorderBrush="#555555"
                                    Background="#222222"
                                    Foreground="White"
                                    Padding="15,5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Row 1: keyboard on the left, results on the right -->
        <Grid Grid.Row="1" ColumnDefinitions="5*,7*">
            <controls:VirtualKeyboardControl Grid.Column="0"
                                             Name="VirtualKeyboard"
                                             MaxWidth="760"
                                             Height="320"
                                             VerticalAlignment="Top"
                                             Margin="10,0,10,10"/>

            <ScrollViewer Grid.Column="1"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          KeyboardNavigation.TabNavigation="Contained">
                <StackPanel>
                    <!-- Columns must match ResultColumns in OmniSearchControl.axaml.cs -->
                    <ItemsControl Name="ResultsList"
                                  ItemsSource="{Binding SearchResults}"
                                  Background="Transparent"
                                  XYFocus.NavigationModes="Enabled">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MediaItemViewModel">
                                <controls:MediaTileControl
                                    Command="{Binding $parent[UserControl].DataContext.PlayCommand}"
                                    CommandParameter="{Binding}"
                                    LongPressCommand="{Binding $parent[UserControl].DataContext.AddToWatchlistCommand}"
                                    LongPressCommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Load More Button -->
                    <Button Content="Load More Results"
                            Command="{Binding LoadMoreCommand}"
                            IsVisible="{Binding HasMoreResults}"
                            HorizontalAlignment="Center"
                            Margin="20"
                            Padding="30,15"
                            FontSize="18"
                            Background="#333333"
                            Foreground="White"
                            CornerRadius="8"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding ShowSpinner}">
                <TextBlock Text="Searching..." FontSize="20" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="200" Margin="0,10,0,0" Height="4"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
