<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:vm="using:Baird.ViewModels"
            xmlns:controls="using:Baird.Controls"
            xmlns:conv="using:Baird.Converters"
            xmlns:asyncImage="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
            mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
            x:Class="Baird.Controls.SeerrchControl"
            x:CompileBindings="True"
            x:DataType="vm:SeerrchViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="TextBox#SearchBox">
            <Setter Property="Background" Value="#1A1F2C"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>
        <Style Selector="TextBox#SearchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1A1F2C"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.SeerrchTileButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SeerrchTileButton:focus">
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1E2330"/>
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
            <Setter Property="ZIndex" Value="10"/>
        </Style>
    </UserControl.Styles>

    <Grid Name="SeerrchGrid" RowDefinitions="Auto,*,Auto" Background="Transparent">

        <!-- Row 0: Search Box and Status -->
        <Border Grid.Row="0" Padding="20" KeyboardNavigation.IsTabStop="False">
            <StackPanel Spacing="6">
                <TextBlock Text="Discover &amp; Request" FontSize="32" FontWeight="Bold" Foreground="#F8FAFC" IsTabStop="False"/>
                <TextBlock Text="Search movies and TV shows to request additions to your library" FontSize="14" Foreground="#94A3B8" Margin="0,0,0,10" IsTabStop="False"/>

                <TextBox Name="SearchBox"
                         Text="{Binding SearchText}"
                         FontSize="24"
                         Watermark="Search for movies and TV shows...">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Up" Command="{Binding $parent[controls:SeerrchControl].MoveFocusUpCommand}" />
                        <KeyBinding Gesture="Down" Command="{Binding $parent[controls:SeerrchControl].MoveFocusDownCommand}" />
                        <KeyBinding Gesture="Enter" Command="{Binding $parent[controls:SeerrchControl].MoveFocusDownCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <!-- Status Message -->
                <Border IsVisible="{Binding ShowStatus}"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,10">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="15"
                               Foreground="#38BDF8"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Row 1: Search Results -->
        <ScrollViewer Grid.Row="1"
                      Focusable="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      KeyboardNavigation.TabNavigation="Contained">
            <ItemsControl Name="ResultsList"
                          ItemsSource="{Binding SearchResults}"
                          Background="Transparent"
                          XYFocus.NavigationModes="Enabled">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeerrchResultViewModel">
                        <Button Classes="SeerrchTileButton"
                                Command="{Binding $parent[UserControl].DataContext.RequestItemCommand}"
                                CommandParameter="{Binding}">
                            <Grid RowDefinitions="*, Auto, Auto">
                                <Border CornerRadius="8" ClipToBounds="True" Height="169" Background="#333333">
                                    <Image asyncImage:ImageLoader.Source="{Binding FullPosterUrl}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Title}"
                                           Foreground="#F8FAFC" FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Left"
                                           Margin="0,5,0,0"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                    <Border Background="#333333" CornerRadius="4" Padding="4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BadgeText}" Foreground="#4CC9F0" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="4,0" VerticalAlignment="Center"
                                            IsVisible="{Binding ShowStatusBadge}">
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading Spinner -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding ShowSpinner}">
            <TextBlock Text="Searching..."
                       FontSize="20"
                       Foreground="#AAAAAA"
                       HorizontalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True"
                         Width="200"
                         Margin="0,10,0,0"
                         Height="4"/>
        </StackPanel>

        <!-- Row 2: Virtual Keyboard -->
        <controls:VirtualKeyboardControl Grid.Row="2"
                                         Name="VirtualKeyboard"
                                         MaxWidth="760"
                                         HorizontalAlignment="Center"
                                         Margin="0,10,0,10"
                                         IsVisible="{Binding !SearchResults.Count}"/>
    </Grid>
</UserControl>
