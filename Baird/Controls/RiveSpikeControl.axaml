<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Baird.ViewModels"
             xmlns:rive="using:Baird.Rive"
             x:Class="Baird.Controls.RiveSpikeControl"
             x:CompileBindings="True"
             x:DataType="vm:RiveSpikeViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
        <KeyBinding Gesture="Right" Command="{Binding IncrementCommand}" />
        <KeyBinding Gesture="Left" Command="{Binding DecrementCommand}" />
    </UserControl.KeyBindings>
    <Grid Background="#090D16" RowDefinitions="Auto,*,Auto" Margin="28">
        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Text="Rive (in-process, native runtime)" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <Button Content="Back" Command="{Binding BackCommand}"/>
        </StackPanel>
        <rive:RivePlayerControl x:Name="Player" Grid.Row="1"
                                Source="{Binding Source}" StateMachine="{Binding StateMachine}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
            <Button Content="-" Command="{Binding DecrementCommand}"/>
            <TextBlock Text="{Binding Rating, StringFormat='rating input = {0}'}" Foreground="White" VerticalAlignment="Center" FontSize="18"/>
            <Button Content="+" Command="{Binding IncrementCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
