<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Baird.ViewModels"
             xmlns:controls="using:Baird.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Baird.Controls.TabNavigationControl"
             x:CompileBindings="True"
             x:DataType="vm:TabNavigationViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="Button.TabButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="22,8"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        
        <!-- Focused Tab (Unselected) -->
        <Style Selector="Button.TabButton:focus">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>

        <!-- Selected Tab (Unfocused, content has focus) -->
        <Style Selector="Button.TabButton.selected">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#252A37"/>
            <Setter Property="BorderBrush" Value="#3B4252"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <!-- Selected Tab (Currently Focused) -->
        <Style Selector="Button.TabButton.selected:focus">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="#FF101216"
          XYFocus.NavigationModes="Enabled"
          XYFocus.DownNavigationStrategy="Projection"
          XYFocus.UpNavigationStrategy="Projection">
        
        <!-- Tab Bar -->
        <Border Grid.Row="0" Background="#16181F" BorderBrush="#252A36" BorderThickness="0,0,0,1" ClipToBounds="True" Height="68" Padding="0,4">
            <!-- Enabled XYFocus for directional navigation (useful for remote/keyboard) -->
             <Canvas Name="CarouselContainer" Background="Transparent" PointerEntered="OnTabBarPointerEntered">
                <ItemsControl Name="TabBar" 
                              ItemsSource="{Binding Tabs}" 
                              KeyboardNavigation.TabNavigation="Once"
                              XYFocus.NavigationModes="Enabled">
                    <ItemsControl.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Canvas.Left" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                        </Transitions>
                    </ItemsControl.Transitions>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:TabItem">
                            <Button Classes="TabButton"
                                    Name="{Binding Title}"
                                    Content="{Binding Title}"
                                    GotFocus="OnTabButtonGotFocus"
                                    KeyDown="OnTabButtonKeyDown"
                                    Command="{Binding $parent[UserControl].((vm:TabNavigationViewModel)DataContext).SelectTabCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Border>

        <!-- Tab Content -->
        <ContentControl Grid.Row="1"
                        Name="TabContent"
                        Content="{Binding SelectedTab.Content}" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch"
                        IsTabStop="False"
                        Focusable="False"
                        GotFocus="OnContentGotFocus">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                    <controls:HistoryControl/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:OmniSearchViewModel}">
                    <controls:OmniSearchControl/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:WatchlistViewModel}">
                    <controls:WatchlistControl/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:CecDebugViewModel}">
                    <controls:CecDebugControl/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:AvDebugViewModel}">
                    <controls:AvDebugControl/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                    <controls:SettingsControl/>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

    </Grid>
</UserControl>
