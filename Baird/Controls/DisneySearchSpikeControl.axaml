<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Baird.ViewModels"
             xmlns:svc="using:Baird.Services"
             xmlns:asyncImage="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             x:Class="Baird.Controls.DisneySearchSpikeControl"
             x:CompileBindings="True"
             x:DataType="vm:DisneySearchSpikeViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
    </UserControl.KeyBindings>

    <Grid Background="#0B0F17" RowDefinitions="Auto,Auto,*,Auto" Margin="32,20">
        <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Background="#113CCF" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="DISNEY+ SEARCH SPIKE" FontWeight="Bold" FontSize="14" Foreground="White"/>
            </Border>
            <TextBlock Text="Search your account's Disney+ catalogue" FontSize="24" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            <TextBox Text="{Binding SearchTerm}" Width="280" FontSize="18" VerticalAlignment="Center"/>
            <Button Content="Search" Command="{Binding SearchCommand}" FontSize="18" FontWeight="Bold"
                    Background="#113CCF" Foreground="White" Padding="20,8" CornerRadius="6"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding Status}" FontSize="18" Foreground="#CBD5E1" Margin="0,14,0,10" TextWrapping="Wrap"/>

        <!-- Results: artwork + title + kind / rating / year -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:DisneySearchResult">
                        <StackPanel Width="240" Margin="0,0,16,16" Spacing="4">
                            <Border CornerRadius="6" ClipToBounds="True" Background="#1E293B" Height="135">
                                <Image asyncImage:ImageLoader.Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Kind}" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding Rating}" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding Year}" FontSize="12" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#111827" CornerRadius="6" Padding="10" Margin="0,8,0,0" MaxHeight="150">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding LogEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontFamily="monospace" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
