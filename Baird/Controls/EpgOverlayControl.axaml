<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Baird.ViewModels"
             xmlns:controls="using:Baird.Controls"
             xmlns:conv="using:Baird.Converters"
             xmlns:asyncImage="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="300"
             x:Class="Baird.Controls.EpgOverlayControl"
             x:CompileBindings="True"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <conv:StringVisibilityConverter x:Key="StringVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="#EA111111" 
            BorderBrush="#444444" 
            BorderThickness="0,2,0,0" 
            Padding="24,16" 
            Height="280"
            VerticalAlignment="Bottom">
        <Grid RowDefinitions="Auto,Auto,*">
            <!-- Top Row: Current Broadcast / Stream HUD -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                <!-- Channel Identity or Stream Source -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveItem.ChannelNumber}" 
                               Foreground="#FFD700" 
                               FontSize="26" 
                               FontWeight="ExtraBold"
                               VerticalAlignment="Center"
                               IsVisible="{Binding ActiveItem.ChannelNumber, Converter={StaticResource StringVisibilityConverter}}"/>
                    <Border Background="#334CC9F0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !ActiveItem.IsLive}">
                        <TextBlock Text="{Binding ActiveItem.Source}" Foreground="#4CC9F0" FontSize="12" FontWeight="Bold"/>
                    </Border>
                    <Border CornerRadius="4" Width="44" Height="30" Background="#333333" ClipToBounds="True" VerticalAlignment="Center">
                        <Image asyncImage:ImageLoader.Source="{Binding ActiveItem.ImageUrl}" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="{Binding ActiveItem.Name}" 
                               Foreground="White" 
                               FontSize="22" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Currently Airing Programme or Stream Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Background="#E50914" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding ActiveItem.IsLive}">
                            <TextBlock Text="NOW" Foreground="White" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <Border Background="#334CAF50" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !ActiveItem.IsLive}">
                            <TextBlock Text="STREAM" Foreground="White" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentProgrammeName, FallbackValue='Playing'}" 
                                   Foreground="White" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <!-- Dismiss Hint -->
                <TextBlock Grid.Column="2" 
                           Text="Press 'G' or 'Back' to close" 
                           Foreground="#777777" 
                           FontSize="12" 
                           VerticalAlignment="Center"/>
            </Grid>

            <Separator Grid.Row="1" Background="#333333" Height="1" Margin="0,0,0,10"/>

            <!-- Bottom Row: Channels & Streaming Shows Carousel -->
            <ListBox Grid.Row="2"
                     Name="OverlayChannelsList"
                     ItemsSource="{Binding Epg.Channels}"
                     SelectedItem="{Binding Epg.SelectedChannel, Mode=TwoWay}"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     XYFocus.NavigationModes="Enabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Focusable" Value="True"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="Border.ChannelPill">
                        <Setter Property="Background" Value="#22FFFFFF"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Padding" Value="14,10"/>
                    </Style>
                    <Style Selector="ListBoxItem:focus Border.ChannelPill">
                        <Setter Property="Background" Value="#444444"/>
                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected Border.ChannelPill">
                        <Setter Property="BorderBrush" Value="#334CAF50"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ChannelScheduleViewModel">
                        <Border Classes="ChannelPill" Width="260" Height="140">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <!-- Feed Header (Channel Number or Source Badge) -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding ChannelNumber}" 
                                               Foreground="#FFD700" 
                                               FontWeight="Bold" 
                                               FontSize="15" 
                                               Margin="0,0,6,0"
                                               IsVisible="{Binding IsLive}"/>
                                    <Border Background="#334CC9F0" CornerRadius="4" Padding="4,2" Margin="0,0,6,0" IsVisible="{Binding !IsLive}">
                                        <TextBlock Text="{Binding Source}" Foreground="#4CC9F0" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Name}" 
                                               Foreground="White" 
                                               FontWeight="Bold" 
                                               FontSize="15" 
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" Background="#22FFFFFF" CornerRadius="4" Padding="4,1">
                                        <TextBlock Text="{Binding DisplayBadge}" Foreground="#DDDDDD" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <!-- Primary item (Now / Next to watch) -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsLive, Converter={x:Static ObjectConverters.IsNotNull}}" Foreground="#81C784" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Now.DisplayTitle}" 
                                               Foreground="White" 
                                               FontSize="13" 
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Now.FormattedTime}" 
                                               Foreground="#888888" 
                                               FontSize="11" 
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Secondary item (Next live or upcoming episode) -->
                                <StackPanel Grid.Row="2" Margin="0,4,0,0" IsVisible="{Binding Next, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="{Binding Next.DisplayTitle}" 
                                               Foreground="#AAAAAA" 
                                               FontSize="12" 
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
