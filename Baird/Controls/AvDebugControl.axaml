<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Baird.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="Baird.Controls.AvDebugControl"
             x:CompileBindings="True"
             x:DataType="vm:AvDebugViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="Button.AvButton">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.AvButton:focus">
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="Background" Value="#3D3D40"/>
        </Style>

        <Style Selector="Button.MarkButton">
            <Setter Property="Background" Value="#B71C1C"/>
        </Style>

        <Style Selector="Button.MarkButton:focus">
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="Background" Value="#D32F2F"/>
        </Style>

        <Style Selector="TextBlock.StatValue">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <Style Selector="TextBlock.StatValue.Warning">
            <Setter Property="Foreground" Value="#FFB74D"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#1E1E1E" Padding="15">
        <Grid ColumnDefinitions="3*,2*" RowDefinitions="Auto,*">

            <!-- Header -->
            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,10">
                <TextBlock Text="A/V Debug" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Border Background="#2D2D30" CornerRadius="3" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="#CCCCCC" FontSize="12"/>
                </Border>
            </StackPanel>

            <!-- Left: live stats -->
            <ScrollViewer Grid.Column="0" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AvStatGroupViewModel">
                            <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                    CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,3"/>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AvStatRowViewModel">
                                                <Grid ColumnDefinitions="230,*">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#999999" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                                               FontFamily="Courier New" TextWrapping="Wrap"
                                                               Classes="StatValue" Classes.Warning="{Binding IsWarning}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Right: controls + event log -->
            <Grid Grid.Column="1" Grid.Row="1" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                        CornerRadius="4" Padding="12" Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                        <WrapPanel Orientation="Horizontal">
                            <Button Name="MarkButton" Content="Mark (felt off)" Classes="AvButton MarkButton" Command="{Binding MarkCommand}"/>
                            <Button Content="{Binding JournalLoggingText}" Classes="AvButton" Command="{Binding ToggleJournalLoggingCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding AudioDelayText}" Foreground="White" FontSize="14"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="Audio −10 ms" Classes="AvButton" Command="{Binding AudioDelayEarlierCommand}"/>
                            <Button Content="Audio +10 ms" Classes="AvButton" Command="{Binding AudioDelayLaterCommand}"/>
                            <Button Content="Reset delay" Classes="AvButton" Command="{Binding AudioDelayResetCommand}"/>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="Reset counters" Classes="AvButton" Command="{Binding ResetCountersCommand}"/>
                            <Button Content="Clear events" Classes="AvButton" Command="{Binding ClearEventsCommand}"/>
                        </WrapPanel>
                        <TextBlock Foreground="#888888" FontSize="11" TextWrapping="Wrap"
                                   Text="+delay = audio later (try if lips move before the sound arrives). Not saved. Press M while watching to drop a mark. With journal logging on, sampling continues after you leave this page: journalctl -t baird | grep AvDebug"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                        CornerRadius="4" Padding="12">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Events" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AvDebugEventViewModel">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#888888"
                                                       FontSize="12" FontFamily="Courier New" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding Color}"
                                                       FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>

</UserControl>
