<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Baird.ViewModels"
    xmlns:controls="using:Baird.Controls"
    xmlns:conv="using:Baird.Converters"
    xmlns:services="using:Baird.Services"
    xmlns:asyncImage="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
    x:CompileBindings="True"
    x:Class="Baird.Controls.ProgrammeDetailControl"
    x:DataType="vm:ProgrammeDetailViewModel"
>

    <UserControl.Resources>
        <conv:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </UserControl.Resources>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
        <KeyBinding Gesture="Back" Command="{Binding BackCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="Button#BackButton">
            <Setter Property="Background" Value="#1E2330"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#BackButton:focus">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#F2101216">

        <Grid RowDefinitions="Auto, *, Auto" Margin="50"
            XYFocus.NavigationModes="Enabled"
            XYFocus.UpNavigationStrategy="Projection"
            XYFocus.DownNavigationStrategy="Projection"
            XYFocus.LeftNavigationStrategy="Projection"
            XYFocus.RightNavigationStrategy="Projection">

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="14">
                <Button Name="BackButton" Content="← Back" HorizontalAlignment="Left" Focusable="True"
                    Command="{Binding BackCommand}" />
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedProgramme.Name}" FontSize="44"
                        FontWeight="Bold" Foreground="#F8FAFC" />
                    <Border Background="#1E293B" CornerRadius="6" Padding="10,3"
                        VerticalAlignment="Center" Margin="0,4,0,0"
                        IsVisible="{Binding SelectedProgramme.Source, Converter={StaticResource StringVisibilityConverter}}">
                        <TextBlock Text="{Binding SelectedProgramme.Source}" FontSize="15"
                            FontWeight="SemiBold" Foreground="#38BDF8" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding SelectedProgramme.Synopsis}" FontSize="20"
                    Foreground="#94A3B8" TextWrapping="Wrap" MaxWidth="900"
                    HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Episodes List -->
            <ScrollViewer Grid.Row="1"
                Margin="0, 30, 0, 0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="EpisodeList"
                    ItemsSource="{Binding ProgrammeChildren}"
                    Background="Transparent"
                    XYFocus.NavigationModes="Enabled">
                    <ItemsControl.Styles>
                        <!-- Styles removed -->
                    </ItemsControl.Styles>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MediaTileControl DataContext="{Binding}"
                                Command="{Binding $parent[UserControl].DataContext.PlayCommand}"
                                CommandParameter="{Binding}"
                                LongPressCommand="{Binding $parent[UserControl].DataContext.AddToWatchlistCommand}"
                                LongPressCommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>