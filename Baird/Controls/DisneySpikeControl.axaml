<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Baird.ViewModels"
             x:Class="Baird.Controls.DisneySpikeControl"
             x:CompileBindings="True"
             x:DataType="vm:DisneySpikeViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
    </UserControl.KeyBindings>

    <Grid Background="#0B0F17" RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="32,20">
        <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Background="#113CCF" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="DISNEY+ PLAYBACK SPIKE" FontWeight="Bold" FontSize="14" Foreground="White"/>
            </Border>
            <TextBlock Text="Play a Disney+ title in Baird" FontSize="24" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            <Border Background="{Binding StateBadgeColor}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="{Binding StateDisplayName}" FontWeight="Bold" FontSize="14" Foreground="White"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
            <TextBox Text="{Binding TargetUrl}" Width="720" FontSize="16" VerticalAlignment="Center"/>
            <Button Content="Launch hidden playback" Command="{Binding LaunchCommand}" FontSize="16" FontWeight="Bold"
                    Background="#113CCF" Foreground="White" Padding="18,10" CornerRadius="6"/>
            <Button Content="Stop" Command="{Binding StopCommand}" FontSize="16" FontWeight="Bold"
                    Background="#7F1D1D" Foreground="#FECACA" Padding="18,10" CornerRadius="6"/>
        </StackPanel>

        <!-- Failures show here, red, with the cause. -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12" CornerRadius="6" Background="#1E293B" Classes.failed="{Binding IsFailed}">
            <Border.Styles>
                <Style Selector="Border.failed">
                    <Setter Property="Background" Value="#7F1D1D"/>
                </Style>
            </Border.Styles>
            <TextBlock Text="{Binding StatusMessage}" FontSize="18" Foreground="#E2E8F0" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0" Spacing="4">
            <TextBlock Text="{Binding DrmStatus}" FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding CurrentVideoTime, StringFormat='video.currentTime: {0:F1}s'}" FontSize="14" Foreground="#94A3B8"/>
                <TextBlock Text="{Binding VideoInfo}" FontSize="14" Foreground="#94A3B8"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="4" Background="#111827" CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding LogEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontFamily="monospace" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
