[Unit]
Description=Baird Media Player
# Crash-loop guard: with Restart=always/RestartSec=5, more than 10 starts in
# 5 minutes puts the unit into "failed" (start-limit-hit) instead of looping
# forever. update_baird.sh watches for this (and for any restart) right after
# an upgrade and rolls back; install_service.sh runs reset-failed first.
StartLimitIntervalSec=300
StartLimitBurst=10
# Binds the service to the graphical session. 
# If you log out (stop the GUI), this service will automatically stop.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/home/linuxbrew/.linuxbrew/bin/baird
Restart=always
RestartSec=5
Environment=DISPLAY=:0
Environment=BAIRD_FULLSCREEN=True
# This is usually unnecessary in user services as systemd inherits it, 
# but keeping it doesn't hurt if your setup is unique.
Environment=XAUTHORITY=/home/%u/.Xauthority
SyslogIdentifier=baird
StandardOutput=journal
StandardError=journal

[Install]
# Starts the service when the Graphical Interface is ready, 
# rather than just when the "User" is ready.
WantedBy=graphical-session.target